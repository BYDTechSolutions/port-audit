{
  "name": "@bydtech/port-audit",
  "version": "0.1.3",
  "description": "Point it at your running app on a local port and get, in seconds, the security problems a passive scan can see: security headers and CSP, cookies, CORS, TLS, HTTP methods, scripts without SRI, vulnerable front-end libraries and version leaks, mapped to OWASP, with a fix snippet for your framework. No Docker, no telemetry.",
  "keywords": [
    "security",
    "owasp",
    "owasp-top-10",
    "asvs",
    "dast",
    "security-headers",
    "cors",
    "csp",
    "localhost",
    "scanner",
    "sarif",
    "junit",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/port-audit#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/port-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/port-audit.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "port-audit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
